#!/bin/sh
# Starts the AIrlock MCP server, which lives inside the AIrlock app binary.
# Set AIRLOCK_APP to point at a specific build (e.g. build/AIrlock.app).
set -eu

# Only builds that contain the MCP mode qualify; older builds share the bundle ID.
supports_mcp() {
    [ -x "$1/Contents/MacOS/AIrlock" ] && grep -aqs -- "--mcp" "$1"/Contents/MacOS/AIrlock*
}

candidates() {
    [ -n "${AIRLOCK_APP:-}" ] && echo "$AIRLOCK_APP"
    echo /Applications/AIrlock.app
    echo "$HOME/Applications/AIrlock.app"
    # Spotlight matches, newest build first.
    mdfind "kMDItemCFBundleIdentifier == 'com.bostjancigan.AIrlock'" 2>/dev/null |
        while IFS= read -r app; do printf '%s\t%s\n' "$(stat -f %m "$app/Contents/MacOS/AIrlock" 2>/dev/null || echo 0)" "$app"; done |
        sort -rn | cut -f2-
}

app=$(candidates | while IFS= read -r c; do supports_mcp "$c" && { echo "$c"; break; }; done)
if [ -z "$app" ]; then
    echo "No AIrlock.app with plugin support found. Install it in /Applications or set AIRLOCK_APP." >&2
    exit 1
fi
exec "$app/Contents/MacOS/AIrlock" --mcp
